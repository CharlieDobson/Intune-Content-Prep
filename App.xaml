<Application x:Class="IntuneContentPrep.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Only keyed resources live here. Implicit (TargetType-only) styles at
                 application scope would shadow the Fluent theme's own default styles
                 and drop the controls back to the classic WPF look. -->

            <!-- Terminal palette (Windows Terminal "Campbell"). The terminal stays dark
                 in both the light and the dark app theme, like a real console. -->
            <SolidColorBrush x:Key="TerminalBackground" Color="#0C0C0C"/>
            <SolidColorBrush x:Key="TerminalHeader" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="TerminalBorder" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="TerminalText" Color="#CCCCCC"/>
            <SolidColorBrush x:Key="TerminalDim" Color="#767676"/>
            <SolidColorBrush x:Key="TerminalCommand" Color="#61D6D6"/>
            <SolidColorBrush x:Key="TerminalWarning" Color="#F9F1A5"/>
            <SolidColorBrush x:Key="TerminalError" Color="#E74856"/>
            <SolidColorBrush x:Key="TerminalSuccess" Color="#16C60C"/>
            <SolidColorBrush x:Key="TerminalLink" Color="#3B78FF"/>
            <SolidColorBrush x:Key="TerminalSelection" Color="#264F78"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
